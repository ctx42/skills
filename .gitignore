.idea

# Per-machine Claude Code settings (local permissions, etc.). Not shipped.
.claude/settings.local.json

# system-check memory is user data, not shipped content. It lives in the
# plugin data dir at runtime; the repo ships only memory.template.md. A local
# copy here (from before the move, or dev use) is kept out of version control.
srd/skills/system-check/memory.md
/tmp/

# Skill eval workspaces: run artifacts (outputs, grades, benchmarks) produced
# by the skill-creator loop. The scenarios themselves are versioned in each
# skill's evals/evals.json; only the runs are transient.
*-workspace/
